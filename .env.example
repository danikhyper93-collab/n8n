# Database: Use Supabase's Session pooler (IPv4) on port 5432, NOT the direct DB host (IPv6-only on free tier).
DB_TYPE=postgresdb
# Supabase Session pooler host (e.g., aws-0-ap-south-1.pooler.supabase.com)
DB_POSTGRESDB_HOST=aws-0-REGION.pooler.supabase.com
# Supabase Session pooler user in the form postgres.<project-ref>
DB_POSTGRESDB_USER=postgres.yourprojectref
# Supabase database password
DB_POSTGRESDB_PASSWORD=your-supabase-db-password
# Port for Supabase Session pooler (5432)
DB_POSTGRESDB_PORT=5432
# Default Supabase database name
DB_POSTGRESDB_DATABASE=postgres
# Dedicated Postgres schema to isolate n8n tables from public
DB_POSTGRESDB_SCHEMA=n8n
# Required for Supabase TLS without mounting a custom CA; also enables Postgres SSL automatically
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# Generate once with `openssl rand -hex 24` and NEVER change it, or all saved credentials will break.
N8N_ENCRYPTION_KEY=replace-with-48-char-hex-from-openssl-rand-hex-24

# Port n8n listens on inside the container
N8N_PORT=5678
# Port Render routes HTTP traffic and health checks to
PORT=5678
# Public protocol used in generated URLs
N8N_PROTOCOL=https
# Optional locally; on Render, entrypoint.sh derives N8N_HOST from RENDER_EXTERNAL_URL if unset
N8N_HOST=localhost
# Optional locally; on Render, entrypoint.sh derives N8N_WEBHOOK_URL (replaces deprecated WEBHOOK_URL) with trailing slash
N8N_WEBHOOK_URL=http://localhost:5678/

# Default timezone for n8n Schedule triggers and workflow dates
GENERIC_TIMEZONE=Asia/Kolkata
# System/Node.js timezone
TZ=Asia/Kolkata

# Store binary files on disk instead of RAM (safer within 512 MB limit)
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
# Cap Node.js heap size to fit comfortably inside Render free tier's 512 MB RAM
NODE_OPTIONS=--max-old-space-size=384

# Automatically delete old workflow execution logs
EXECUTIONS_DATA_PRUNE=true
# Hours to keep finished execution data before pruning (72 = 3 days)
EXECUTIONS_DATA_MAX_AGE=72

# Disable anonymous usage telemetry
N8N_DIAGNOSTICS_ENABLED=false
# Skip onboarding personalization survey
N8N_PERSONALIZATION_ENABLED=false
